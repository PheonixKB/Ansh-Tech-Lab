---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { withBase } from '../utils/url';
const { title } = Astro.props;
// Staging copy on a github.io project address (base path is not "/"): keep it out of search engines.
// Disappears automatically on the custom domain, where there is no base path.
const isStaging = import.meta.env.BASE_URL !== '/';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Ansh Tech Labs</title>
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    {isStaging && <meta name="robots" content="noindex, nofollow" />}
  </head>
  <body class="bg-ink-950 text-text">
    <Navbar currentPath={Astro.url.pathname} />
    <main><slot /></main>
    <Footer />
  </body>
</html>
---
import Layout from '../layouts/Layout.astro';

const title = 'Privacy Policy';
const description = 'Privacy policy for Ansh Tech Labs website.';
---

<Layout title={title} description={description}>
  <section class="section hero-glow pb-12 pt-16 md:pt-24">
    <div class="container-site">
      <p data-ix="eyebrow" class="eyebrow">Legal</p>
      <h1 class="mb-6">Privacy Policy</h1>
      <p data-ix="lead" class="text-muted">Last updated: October 18, 2026</p>
    </div>
  </section>

  <section class="section pt-0 md:pt-0 xl:pt-0">
    <div class="container-site max-w-4xl space-y-12">
      <div data-ix="large">
        <h2 class="mb-4 text-3xl">Information We Collect</h2>
        <ul class="list-disc space-y-2 pl-6 text-muted">
          <li>Contact form submissions (name, email, organization, message)</li>
        </ul>
      </div>
      <div data-ix="large">
        <h2 class="mb-4 text-3xl">How We Use Information</h2>
        <ul class="list-disc space-y-2 pl-6 text-muted">
          <li>To respond to inquiries and requests</li>
          <li>To improve our services and products</li>
        </ul>
      </div>
      <div data-ix="large">
        <h2 class="mb-4 text-3xl">Data Recipients</h2>
        <p class="text-muted">
          Submissions are emailed to company-approved recipients. The form provider processes submissions per their data handling policy.
        </p>
      </div>
      <div data-ix="large">
        <h2 class="mb-4 text-3xl">Visitor Warning</h2>
        <p class="text-muted">
          Please do not include case evidence, personal identifiers or sensitive operational details in any communication.
        </p>
      </div>
      <div data-ix="large">
        <h2 class="mb-4 text-3xl">Changes to This Policy</h2>
        <p class="text-muted">
          We may update this privacy policy from time to time. We will notify of any changes by posting the new privacy policy on this page.
        </p>
      </div>
    </div>
  </section>
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { withBase } from '../../utils/url';
import { solutions } from '../../data/solutions';

const groups = [
  {
    id: 'law-enforcement',
    title: 'For Law Enforcement',
    items: solutions.filter((s) => s.audiences.includes('law-enforcement')),
  },
  {
    id: 'corporate-security',
    title: 'For Corporate Security',
    items: solutions.filter((s) => s.audiences.includes('corporate-security')),
  },
];
---

<Layout
  title="Solutions"
  description="Digital forensics, OSINT and cyber-intelligence tools for law-enforcement agencies and corporate security teams."
>
  <section class="section hero-glow pb-12 pt-16 md:pt-24">
    <div class="container-site">
      <p data-ix="eyebrow" class="eyebrow">Solutions</p>
      <h1 class="mb-6 max-w-5xl">Specialized tools. One investigative purpose.</h1>
      <p data-ix="lead" class="max-w-2xl text-lg text-muted">
        Four solutions across collection, correlation and analysis, built for investigation teams.
      </p>
    </div>
  </section>

  {groups.map((group, gi) => (
    <section id={group.id} class:list={['section scroll-mt-24', gi % 2 === 1 && 'bg-ink-800']}>
      <div class="container-site">
        <h2 class="mb-12">{group.title}</h2>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
          {group.items.map((s) => (
            <ProductCard solution={s} index={solutions.indexOf(s)} />
          ))}
        </div>
        {group.id === 'corporate-security' && (
          <p data-ix="small" class="mt-8 text-muted">
            Need something specific to your organization?{' '}
            <a href={withBase('/contact/')} class="text-cyan-text underline underline-offset-4 hover:text-cyan-hover">Talk to us.</a>
          </p>
        )}
      </div>
    </section>
  ))}

  <section class="section">
    <div class="container-site">
      <div data-ix="large" class="rounded-xl border border-line bg-band p-8 md:p-12 lg:flex lg:items-center lg:justify-between lg:gap-12">
        <div class="mb-8 max-w-2xl lg:mb-0">
          <h2 class="mb-4">Not sure which solution fits? Tell us your challenge.</h2>
        </div>
        <a href={withBase('/contact/')} class="btn btn-primary">Request a Demo</a>
      </div>
    </div>
  </section>
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import { solutions } from '../../data/solutions';
---

<Layout title="Solutions" description="Digital forensics, OSINT and cyber-intelligence tools for law-enforcement agencies and corporate security teams.">
  <section class="mx-auto max-w-6xl px-6 py-12">
    <h1 class="mb-4 text-3xl font-bold">Solutions</h1>
    <p class="text-muted lg:text-lg">Four focused offerings built around the pillars of Collect, Correlate and Analyze/Report.</p>
    <div class="grid grid-cols-1 gap-6 py-8 md:grid-cols-2 lg:grid-cols-3">
      {solutions.map((sol) => (
        <div class="border border-line rounded p-6 transition-colors hover:border-cyan">
          <h2 class="mb-2 text-xl font-medium">{sol.name}</h2>
          <p class="text-muted">{sol.blurb}</p>
          <a href={`/solutions/${sol.slug}/`} class="mt-3 block text-cyan hover:underline">Explore solution ↗</a>
        </div>
      ))}
    </div>
  </section>
</Layout>
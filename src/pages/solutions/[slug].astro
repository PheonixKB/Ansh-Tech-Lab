---
import { withBase } from '../../utils/url';
import Layout from '../../layouts/Layout.astro';
import { solutions } from '../../data/solutions';

export const getStaticPaths = () =>
  solutions.map((s) => ({ params: { slug: s.slug }, props: { s } }));

const { s } = Astro.props;
---

<Layout title={s.name} description={s.sub}>
  <section class="section hero-glow pb-12 pt-16 md:pt-24">
    <div class="container-site">
      <nav data-ix="eyebrow" aria-label="Breadcrumb" class="mb-6 text-sm">
        <a href={withBase('/solutions/')} class="text-muted hover:text-text">← Back to Solutions</a>
      </nav>
      <p data-ix="eyebrow" class="eyebrow">{s.eyebrow}</p>
      <h1 class="mb-6 max-w-5xl">{s.name}</h1>
      <p data-ix="lead" class="mb-10 max-w-2xl text-lg text-muted">{s.sub}</p>
      <div data-ix="small" class="flex flex-col gap-4 sm:flex-row">
        <a href={withBase('/contact/')} class="btn btn-primary">Request a Demo</a>
        <a href={withBase('/solutions/')} class="btn btn-secondary">All Solutions</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-site grid grid-cols-1 gap-6 md:grid-cols-2">
      <div data-ix="large" class="card">
        <h2 class="mb-4 text-3xl">Challenge</h2>
        <p class="text-muted">{s.challenge.body}</p>
      </div>
      <div data-ix="large" class="card">
        <h2 class="mb-4 text-3xl">Core Focus</h2>
        <p class="text-muted">{s.coreFocus}</p>
      </div>
    </div>
  </section>

  <section class="section bg-ink-800">
    <div class="container-site">
      <h2 class="mb-12">Capabilities</h2>
      <ul class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {s.capabilities.map((cap) => (
          <li data-ix="large" class="card">
            <h3 class="mb-3 text-2xl">{cap.title}</h3>
            <p class="text-muted">{cap.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container-site">
      <h2 class="mb-12">Workflow</h2>
      <ol data-pipeline class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
        {s.workflow.map((step, i) => (
          <li data-ix="large" data-step class="card">
            <p class="mb-6 text-sm text-cyan-text">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="mb-3 text-2xl">{step.title}</h3>
            <p class="text-muted">{step.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Layout>

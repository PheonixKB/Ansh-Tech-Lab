---
import { withBase } from '../../utils/url';
import Layout from '../../layouts/Layout.astro';
import { solutions } from '../../data/solutions';
export const getStaticPaths = () =>
  solutions.map((s) => ({ params: { slug: s.slug }, props: { s } }));

const { s } = Astro.props;
---

<Layout title={s.name} description={s.sub}>
  <section class="mx-auto max-w-6xl px-6 py-12">
    <nav class="mb-6">
      <a href={withBase("/solutions/")} class="text-muted hover:text-cyan">← Back to Solutions</a>
    </nav>
    <h1 class="mb-4 text-4xl font-bold text-cyan">{s.name}</h1>
    <p class="text-muted">{s.sub}</p>
    <div class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-2">
      <div>
        <h2 class="mb-4 font-medium">Challenge</h2>
        <p class="text-muted">{s.challenge.body}</p>
      </div>
      <div>
        <h2 class="mb-4 font-medium">Core Focus</h2>
        <p class="text-muted">{s.coreFocus}</p>
      </div>
    </div>
    <div class="mt-6">
      <h2 class="mb-4 font-medium">Capabilities</h2>
      <ul class="space-y-2 text-muted">
        {s.capabilities.map((cap) => (
          <li class="mb-2">
            <strong>{cap.title}:</strong> {cap.body}
          </li>
        ))}
      </ul>
    </div>
    <div class="mt-6">
      <h2 class="mb-4 font-medium">Workflow</h2>
      <ul class="space-y-2 text-muted">
        {s.workflow.map((step) => (
          <li class="mb-2">
            <strong>{step.title}:</strong> {step.body}
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>
---
import Layout from '../layouts/Layout.astro';

const title = 'About Ansh Tech Labs';
const description = 'A specialized technology hub for digital investigation.';
---

<Layout title={title} description={description}>
  <section class="prose lg:prose-xl max-w-none">
    <h1 class="text-3xl font-bold">A specialized technology hub for digital investigation.</h1>
    <p class="text-muted lg:text-larger mb-8">
      We develop advanced forensic tools and cyber intelligence platforms that bridge the gap between complex digital data and actionable legal evidence.
    </p>

    <section class="bg-ink-800 pt-8 pb-12">
      <h2 class="text-2xl font-medium mb-4">01 / OUR MISSION</h2>
      <p class="text-muted">
        Building precise, reliable tools for the investigation community. Every solution is designed with the investigator's workflow in mind.
      </p>
    </section>

    <section class="py-8">
      <h2 class="text-2xl font-medium mb-4">02 / EXPERTISE</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div>
          <h3 class="font-medium">White-hat hackers</h3>
          <p class="text-muted">
            Ethical security research and vulnerability discovery.
          </p>
        </div>
        <div>
          <h3 class="font-medium">Forensic analysts</h3>
          <p class="text-muted">
            Digital evidence examination and case construction.
          </p>
        </div>
        <div>
          <h3 class="font-medium">Software engineers</h3>
          <p class="text-muted">
            Building scalable forensic platforms and automation.
          </p>
        </div>
      </div>
    </section>

    <section class="py-8">
      <h2 class="text-2xl font-medium mb-4">03 / WHO WE SERVE</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <h3 class="font-medium">Law Enforcement Agencies</h3>
          <p class="text-muted">
            End-to-end evidence collection and analysis pipelines.
          </p>
        </div>
        <div>
          <h3 class="font-medium">Corporate Security Teams</h3>
          <p class="text-muted">
            Monitoring OSINT and threat intelligence to prevent data breaches.
          </p>
        </div>
      </div>
    </section>

    <section class="py-8 bg-ink-800">
      <h2 class="text-2xl font-medium mb-4">04 / HOW WE WORK</h2>
      <p class="text-muted">
        <strong>Precision in data.</strong> Clarity in evidence. Our principles guide every tool we build and every investigation we support.
      </p>
      <p class="mt-4 text-muted">
        Please do not include case evidence, personal identifiers or sensitive operational details.
      </p>
    </section>
  </section>
</Layout>
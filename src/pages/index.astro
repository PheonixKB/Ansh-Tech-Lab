---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { withBase } from '../utils/url';
import { solutions } from '../data/solutions';


const audiences = [
  {
    title: 'For Law Enforcement',
    body: 'Connect evidence collection and analysis across police, forensic labs and government investigations.',
    tags: ['Digital evidence', 'UAV forensics', 'Biometrics'],
    href: '/solutions/#law-enforcement',
  },
  {
    title: 'For Corporate Security',
    body: 'Monitor open-source signals and threat intelligence to identify exposure and help prevent data breaches.',
    tags: ['OSINT', 'Deep web monitoring', 'Threat intelligence'],
    href: '/solutions/#corporate-security',
  },
];

const capabilities = [
  'Digital evidence',
  'UAV forensics',
  'Biometrics',
  'OSINT',
  'Deep web monitoring',
  'Threat intelligence',
  'Law enforcement',
  'Corporate security',
];

const pipeline = [
  { title: 'Collect', body: 'Gather relevant digital, open-source or field evidence.' },
  { title: 'Correlate', body: 'Connect entities, events and data points in context.' },
  { title: 'Analyze', body: 'Examine relationships and reconstruct activity.' },
  { title: 'Report', body: 'Organize findings for investigative and legal review.' },
];
---

<Layout
  title="Digital forensics & OSINT platforms"
  description="Intelligence platforms and forensic tools for law enforcement and corporate security teams."
>
  <!-- 1. Hero: accent surface, headline + four solution cards (template Hero) -->
  <header class="section surface-accent">
    <div class="container-site">
      <p data-ix="eyebrow" class="eyebrow">Digital forensics, OSINT and cyber-intelligence</p>
      <h1 class="mb-6 max-w-5xl">From complex digital data to actionable legal evidence</h1>
      <p data-ix="lead" class="mb-8 max-w-2xl text-lg">
        Intelligence platforms and forensic tools for the teams that turn fragmented digital traces into meaningful investigative insight.
      </p>
      <div data-ix="small" class="mb-12 flex flex-col gap-4 sm:flex-row">
        <a href={withBase('/contact/')} class="btn btn-on-accent">Request a Demo</a>
        <a href={withBase('/solutions/')} class="btn border border-ink-950">Explore Solutions</a>
      </div>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {solutions.map((s, i) => <ProductCard solution={s} index={i} heading="h2" />)}
      </div>
    </div>
  </header>

  <!-- 2. Capability marquee (template Logos band; text, not invented client logos) -->
  <section class="section py-10 md:py-12 xl:py-12" aria-label="Capabilities">
    <div class="container-site">
      <p data-ix="eyebrow" class="eyebrow">Built for investigative workflows</p>
      <div class="marquee text-xl text-muted">
        <ul class="marquee-track">
          {capabilities.map((c) => <li class="whitespace-nowrap">{c}</li>)}
        </ul>
        <ul class="marquee-track" aria-hidden="true">
          {capabilities.map((c) => <li class="whitespace-nowrap">{c}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- 3. Feature tabs (template Features): one tab per solution -->
  <section class="section bg-ink-800">
    <div class="container-site">
      <div class="mb-12 max-w-3xl">
        <p data-ix="eyebrow" class="eyebrow">The solution portfolio</p>
        <h2 class="mb-4">Specialized tools. One investigative purpose.</h2>
      </div>
      <div data-tabs>
        <div role="tablist" aria-label="Solutions" class="grid grid-cols-1 gap-x-4 sm:grid-cols-2 lg:grid-cols-4">
          {solutions.map((s, i) => (
            <button type="button" role="tab" id={`tab-${s.slug}`} aria-controls={`panel-${s.slug}`} class="tab-link">
              <span class="block text-lg font-medium">{s.name}</span>
              <span class="block text-sm">{s.category}</span>
            </button>
          ))}
        </div>
        {solutions.map((s) => (
          <div role="tabpanel" id={`panel-${s.slug}`} aria-labelledby={`tab-${s.slug}`} class="card mt-6 grid gap-8 md:grid-cols-2" tabindex="0">
            <div>
              <h3 class="mb-3">{s.headline.join(' ')}</h3>
              <p class="mb-6 text-muted">{s.sub}</p>
              <a href={withBase(`/solutions/${s.slug}/`)} class="btn btn-primary">Explore {s.name}</a>
            </div>
            <ul class="space-y-4">
              {s.capabilities.slice(0, 3).map((c) => (
                <li>
                  <p class="font-medium">{c.title}</p>
                  <p class="text-sm text-muted">{c.body}</p>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Who we serve -->
  <section class="section">
    <div class="container-site">
      <p data-ix="eyebrow" class="eyebrow">01 / Who we serve</p>
      <h2 class="mb-4 max-w-3xl">Different mandates. Shared need for clarity.</h2>
      <p data-ix="lead" class="mb-12 max-w-2xl text-muted">
        From public-sector investigations to enterprise threat monitoring, put the right intelligence in the right hands.
      </p>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        {audiences.map((a) => (
          <article data-ix="large" class="card relative flex flex-col">
            <h3 class="mb-3">
              <a href={withBase(a.href)} class="after:absolute after:inset-0 focus-visible:outline-offset-8">
                {a.title}
              </a>
            </h3>
            <p class="mb-6 text-muted">{a.body}</p>
            <ul class="mt-auto flex flex-wrap gap-2">
              {a.tags.map((t) => <li class="tag">{t}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. From signal to evidence -->
  <section class="section">
    <div class="container-site">
      <p data-ix="eyebrow" class="eyebrow">03 / From signal to evidence</p>
      <h2 class="mb-4 max-w-3xl">A clear path through complex data.</h2>
      <p data-ix="lead" class="mb-12 max-w-2xl text-muted">
        A common investigative framework connects collection, context, analysis and reporting across our solutions.
      </p>
      <ol data-pipeline class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
        {pipeline.map((step, i) => (
          <li data-ix="large" data-step class="card">
            <p class="mb-6 text-sm text-cyan-text">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="mb-3">{step.title}</h3>
            <p class="text-muted">{step.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- CTA: accent split block (template CTA) -->
  <section class="section pt-0 md:pt-0 xl:pt-0">
    <div class="container-site">
      <div data-ix="large" class="surface-accent rounded-xl p-8 md:p-12 lg:flex lg:items-center lg:justify-between lg:gap-12">
        <div class="mb-8 max-w-2xl lg:mb-0">
          <p class="eyebrow">Start a conversation</p>
          <h2 class="mb-4">Bring clarity to your next investigation.</h2>
          <p>Talk to our team about your evidence workflow, intelligence needs and the right solution for your organization.</p>
        </div>
        <div class="flex flex-col gap-4 sm:flex-row lg:flex-col">
          <a href={withBase('/contact/')} class="btn btn-on-accent">Request a Demo</a>
          <a href={withBase('/contact/')} class="btn border border-ink-950">Or Contact Us</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';

const title = 'Contact / Request a Demo';
const description = 'Get in touch with Ansh Tech Labs';
---

<Layout title={title} description={description}>
  <section class="section hero-glow pb-12 pt-16 md:pt-24">
    <div class="container-site">
      <p data-ix="eyebrow" class="eyebrow">Contact</p>
      <h1 class="mb-6">Request a Demo</h1>
      <p data-ix="lead" class="max-w-2xl text-lg text-muted">
        Ready to bring clarity to your investigation? Fill out the form below and our team will be in touch shortly.
      </p>
    </div>
  </section>

  <section class="section pt-0 md:pt-0 xl:pt-0">
    <div class="container-site">
      <div data-ix="large" class="card">
        <p class="mb-8 text-muted">
          <strong class="font-medium text-text">Note:</strong> The contact form is currently disabled. Until a form provider is approved by the admins, please use the contact details below.
        </p>
        <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
          <div>
            <h2 class="mb-3 text-2xl">Email</h2>
            <p class="text-muted">{site.contact.email}</p>
          </div>
          <div>
            <h2 class="mb-3 text-2xl">Location</h2>
            <p class="text-muted">Gandhinagar, Gujarat, India</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

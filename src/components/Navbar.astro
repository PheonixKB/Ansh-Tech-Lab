---
import { withBase, stripBase } from '../utils/url';
import { site } from '../data/site';

const currentPath = stripBase(Astro.url.pathname);
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);

const linkClass = (href: string) =>
  isActive(href) ? 'text-cyan-text' : 'text-muted hover:text-text';
---

<header class="sticky top-0 z-40 pt-3 sm:pt-4">
  <div class="container-site">
    <nav
      data-nav
      aria-label="Main"
      class="relative rounded-xl border border-line bg-ink-900/80 backdrop-blur"
    >
      <div class="flex h-16 items-center justify-between px-4 sm:px-6">
        <a href={withBase('/')} class="text-lg font-medium tracking-tight text-text">
          Ansh Tech Labs
        </a>

        <ul class="hidden items-center gap-8 md:flex">
          {site.nav.map((item) => (
            <li>
              <a
                href={withBase(item.href)}
                class={linkClass(item.href)}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
          <li>
            <a href={withBase('/contact/')} class="btn btn-primary">Request a Demo</a>
          </li>
        </ul>

        <button
          type="button"
          data-nav-toggle
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="inline-flex size-11 items-center justify-center rounded-lg border border-line text-text md:hidden"
        >
          <span class="sr-only">Menu</span>
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
            <path d="M3 6h14M3 10h14M3 14h14"></path>
          </svg>
        </button>
      </div>

      <div id="mobile-menu" data-nav-panel class="hidden border-t border-line px-4 py-4 md:hidden">
        <ul class="flex flex-col gap-1">
          {site.nav.map((item) => (
            <li>
              <a
                href={withBase(item.href)}
                class:list={['block rounded-lg px-3 py-3', linkClass(item.href)]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
          <li class="pt-2">
            <a href={withBase('/contact/')} class="btn btn-primary w-full">Request a Demo</a>
          </li>
        </ul>
      </div>
    </nav>
  </div>
</header>

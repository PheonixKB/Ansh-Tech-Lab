---
import { withBase, stripBase } from '../utils/url';

const currentPath = stripBase(Astro.url.pathname);
---

<nav class="border-b border-line bg-ink-900/50 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-[1200px] items-center justify-between px-6">
    <a href={withBase('/')} class="font-mono text-sm uppercase tracking-wider text-cyan">
      ANSH TECH LABS
    </a>
    <ul class="flex gap-8 text-muted">
      <li>
        <a href={withBase('/')} class={currentPath === '/' ? 'text-cyan' : 'text-muted hover:text-cyan'}>
          Home
        </a>
      </li>
      <li>
        <a href={withBase('/solutions/')} class={currentPath.startsWith('/solutions') ? 'text-cyan' : 'text-muted hover:text-cyan'}>
          Solutions
        </a>
      </li>
      <li>
        <a href={withBase('/about/')} class={currentPath === '/about/' ? 'text-cyan' : 'text-muted hover:text-cyan'}>
          About
        </a>
      </li>
      <li>
        <a href={withBase('/contact/')} class="px-6 py-3 font-medium text-cyan">
          Request a Demo
        </a>
      </li>
    </ul>
  </div>
</nav>

---
import { withBase } from '../utils/url';
import { site } from '../data/site';
import { solutions } from '../data/solutions';
---

<footer class="footer-section border-t border-line">
  <div class="container-site grid grid-cols-1 gap-10 py-16 sm:grid-cols-2 lg:grid-cols-4">
    <div data-ix="large" class="lg:col-span-2">
      <a href={withBase('/')} class="mb-4 block text-lg font-medium tracking-tight text-text">
        Ansh Tech Labs
      </a>
      <p class="max-w-md text-muted">{site.tagline}</p>
    </div>
    <div data-ix="large">
      <h2 class="mb-4 text-xl text-text">Solutions</h2>
      <ul class="space-y-2 text-muted">
        {solutions.map((s) => (
          <li>
            <a href={withBase(`/solutions/${s.slug}/`)} class="hover:text-cyan-text">{s.name}</a>
          </li>
        ))}
      </ul>
    </div>
    <div data-ix="large">
      <h2 class="mb-4 text-xl text-text">Company</h2>
      <ul class="space-y-2 text-muted">
        <li><a href={withBase('/about/')} class="hover:text-cyan-text">About</a></li>
        <li><a href={withBase('/contact/')} class="hover:text-cyan-text">Contact</a></li>
        <li><a href={withBase('/privacy/')} class="hover:text-cyan-text">Privacy</a></li>
      </ul>
    </div>
  </div>
  <div class="container-site">
    <div data-ix="divider" class="divider"></div>
    <div class="flex flex-col gap-2 py-8 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>© 2026 Ansh Tech Labs Pvt. Ltd.</p>
      <p>{site.footerMotto}</p>
    </div>
  </div>
</footer>
